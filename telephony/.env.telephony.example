# ==============================================================================
# V.I.E.R.N.E.S. - Variables de Entorno de Telefonía SIP / Asterisk (Chile)
# ==============================================================================

# IP Pública del Servidor para Señalización SIP y Media RTP en Chile
PUBLIC_IP=200.1.2.3

# Asterisk ARI (REST API & WebSockets)
ARI_URL=http://127.0.0.1:8088/ari
ARI_WS_URL=ws://127.0.0.1:8088/ari/events
ARI_USER=viernes-ari-user
ARI_PASSWORD=ViernesSecretPass2026

# Asterisk AMI (Manager Interface)
AMI_PORT=5038
AMI_USER=viernes-ami-user
AMI_SECRET=ViernesAMISecret2026

# AudioSocket Port (Streaming AI)
AUDIOSOCKET_PORT=9099

# Caller ID Predeterminado para Salidas Nacionales en Chile (Formato E.164)
CALLER_ID_CL=+56912345678

# ------------------------------------------------------------------------------
# 1. CREDENCIALES ZADARMA CHILE (Santiago / Móviles)
# ------------------------------------------------------------------------------
ZADARMA_SIP_ID=123456
ZADARMA_SIP_PASSWORD=TuPasswordZadarma
ZADARMA_DID_CL=+56229876543

# ------------------------------------------------------------------------------
# 2. CREDENCIALES REDVOISS CHILE (Carrier Local Santiago)
# ------------------------------------------------------------------------------
REDVOISS_USER=redvoiss_user_cl
REDVOISS_PASSWORD=TuPasswordRedvoiss
REDVOISS_DID_CL=+56223456789

# ------------------------------------------------------------------------------
# 3. CREDENCIALES TWILIO ELASTIC SIP TRUNKING CHILE
# ------------------------------------------------------------------------------
TWILIO_SIP_DOMAIN=viernes-telephony
TWILIO_CREDENTIAL_USER=twilio_sip_user
TWILIO_CREDENTIAL_PASS=TuPasswordTwilio
TWILIO_DID_CL=+56987654321

# ------------------------------------------------------------------------------
# 4. CREDENCIALES NET2PHONE CHILE
# ------------------------------------------------------------------------------
NET2PHONE_USER=net2phone_user_cl
NET2PHONE_PASS=TuPasswordNet2Phone
NET2PHONE_DID_CL=+56225556677

# ------------------------------------------------------------------------------
# CREDENCIALES INTERNAS Y WEBRTC
# ------------------------------------------------------------------------------
SIP_INTERNAL_PASS_1001=InternalPass1001
SIP_WEBRTC_PASS=WebRTCPassword2026
