# Gemini Live API (Google AI Studio) - Free Tier
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-2.0-flash-exp"

# GitHub Integration
GITHUB_TOKEN="ghp_YourPersonalAccessTokenWithRepoScope"
GITHUB_USERNAME="BrunoAle-115"
GITHUB_REPOS="BrunoAle-115/Proyecto-Viernes-Pi"
GITHUB_POLL_INTERVAL_SECONDS=120

# Google Gmail (OAuth2 credentials)
GMAIL_CREDENTIALS_FILE="credentials/gmail_credentials.json"
GMAIL_TOKEN_FILE="credentials/gmail_token.json"
GMAIL_USER_ID="me"
GMAIL_POLL_INTERVAL_SECONDS=60

# Zoho Mail IMAP
ZOHO_IMAP_SERVER="imappro.zoho.com"
ZOHO_IMAP_PORT=993
ZOHO_IMAP_USE_SSL=true
ZOHO_EMAIL_USER="tu_correo@tu_dominio.com"
ZOHO_EMAIL_PASSWORD="your_app_specific_password"
ZOHO_POLL_INTERVAL_SECONDS=60

# Telephony / Asterisk / SIP Trunk (Chile)
SIP_PROVIDER="zadarma_chile" # zadarma_chile, redvoiss, twilio_cl, net2phone
SIP_SERVER="sip.zadarma.com"
SIP_PORT=5060
SIP_USERNAME="123456"
SIP_PASSWORD="YourSipSecretPassword"
SIP_DID_NUMBER="+56912345678"
ASTERISK_AMI_HOST="127.0.0.1"
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER="viernes"
ASTERISK_AMI_SECRET="viernes_ami_pass_2026"

# Wake-on-LAN & Red Local
DEFAULT_BROADCAST_IP="192.168.1.255"
TARGET_PC_IP="192.168.1.150"
TARGET_PC_NAME="PC-Principal"

# Web Dashboard HUD
WEB_HOST="0.0.0.0"
WEB_PORT=8080
HUD_THEME="stark_cyberpunk"
